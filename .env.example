# Copy to .env and adjust as needed

JWT_SECRET=change-this-to-a-strong-random-secret
OLLAMA_HOST=http://ollama:11434
DATABASE_URL=sqlite:////app/db/fintelligence.db
CHROMA_DB_PATH=/app/chroma_db
REPORTS_DIR=/app/reports
UPLOADS_DIR=/app/uploads

# ── Local project model names (created with scripts/setup-local-models.ps1) ─
LLM_MODEL=fintel-analyst:final
VISION_MODEL=fintel-vision:final

# Context window in tokens — reduce to 2048 if you hit OOM
LLM_CTX=4096
